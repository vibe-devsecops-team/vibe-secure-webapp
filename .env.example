# 將此檔複製為 .env 並填入真實值。
# .env 已被 .gitignore 排除，不會進版控；本檔（.env.example）只放佔位值，可安全進版控。
#   cp .env.example .env

# === AI API（開發工具用：透過 Gemini API 生成程式碼）===
# 注意：這是「開發階段」用來生成程式碼的憑證，部署後的網頁應用本身不會呼叫 Gemini。
# 於 Google AI Studio (https://aistudio.google.com) 申請免費 key，新版格式以 AQ. 開頭（舊版為 AIza）。
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.2

# === PostgreSQL ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me

# === Flask ===
FLASK_SECRET_KEY=change_me
FLASK_ENV=development
