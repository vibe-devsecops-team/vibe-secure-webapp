# 將此檔複製為 .env 並填入真實值。
# .env 已被 .gitignore 排除，不會進版控；本檔（.env.example）只放佔位值，可安全進版控。
#   cp .env.example .env

# === AI API（依團隊選定的提供者填寫，全組統一同一個模型）===
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here

# === PostgreSQL ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me

# === Flask ===
FLASK_SECRET_KEY=change_me
FLASK_ENV=development
